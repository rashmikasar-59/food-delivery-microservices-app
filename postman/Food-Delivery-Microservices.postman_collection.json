      "name": "01 Register customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/user",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "user"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Customer\",\n  \"email\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phoneNumber\": 9876543210\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates a CUSTOMER account. Public registration ignores submitted privileged roles."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration returns 201', function () { pm.response.to.have.status(201); });",
              "let body = pm.response.json();",
              "if (body && body.id) pm.collectionVariables.set('userId', body.id);",
              "if (body && body.email) pm.collectionVariables.set('customerUsername', body.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login customer (save token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "token"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Login response is expected to be a raw JWT string. Saves it as token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
              "let t = pm.response.text().trim();",
              "try { t = JSON.parse(t); } catch (e) {}",
              "if (typeof t === 'string' && t.length > 20) pm.collectionVariables.set('token', t);",
              "pm.test('JWT token was captured', function () { pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
